# contrib/netbox-seed/pins.env: the proven set the capture runs against (scope 3.10.1, IR-37).
# capture.py reads this file, checks the running instance against it, and writes the manifest's
# versions from it, so the manifest and this file cannot disagree (handover §15.2, REQ-46-33).
# Each base image is pinned here by digest, measured on ai-netsim, and capture.py pulls it by that
# digest. The manifest carries no digest: its keys are fixed (handover §7; ruling 46-S3-R2). The
# image capture.py builds on top is printed per capture and goes into the capture record.
NETBOX_VERSION=4.6.8
NETBOX_BGP_VERSION=0.19.0
NETBOX_DOCKER_TAG=v4.6.8-5.0.2
NETBOX_IMAGE=netboxcommunity/netbox:v4.6.8-5.0.2
NETBOX_IMAGE_DIGEST=sha256:3a105e0cc585aa823f327e1034dc5fb7a6e1cea6d210c5bf61badd68d784650d
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_IMAGE_DIGEST=sha256:b6972e1115a4ff8eba5d7f7d19184926d1e16d7d1136ae1e1a7ebf286da0f015
VALKEY_IMAGE=valkey/valkey:9.1-alpine
VALKEY_IMAGE_DIGEST=sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
SITE_SLUG=site-a
